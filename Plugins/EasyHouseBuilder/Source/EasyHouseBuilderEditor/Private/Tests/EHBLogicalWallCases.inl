 TestTrue(TEXT("Wall query works without generated components"),Wall->QueryLogicalBaseSurfaces(Surfaces,Status));if(Surfaces.Num()!=2)return false;for(int32 I=0;I<2;++I){TestEqual(TEXT("Renderer-free ID"),Surfaces[I].SurfaceGuid,Before[I].SurfaceGuid);TestEqual(TEXT("Renderer-free trimmed area"),Surfaces[I].GetAreaCm2(),Before[I].GetAreaCm2());}TestEqual(TEXT("Query never registers new identities"),Wall->LogicalSurfaceIdentities.Num(),Identities.Num());
 Wall->CurveControlOffset=60;TestFalse(TEXT("Curved source never flattened into one plane"),Wall->QueryLogicalBaseSurfaces(Surfaces,Status));TestEqual(TEXT("Explicit curved definition requirement"),Status,FName(TEXT("CurvedLogicalSurfaceRequiresDefinition")));TestTrue(TEXT("Failed query clears partial output"),Surfaces.IsEmpty());Wall->CurveControlOffset=0;Wall->Thickness=0;TestFalse(TEXT("Invalid author thickness rejected"),Wall->QueryLogicalBaseSurfaces(Surfaces,Status));Wall->Thickness=24;
 Wall->SetActorScale3D(FVector(2,1,1));TestFalse(TEXT("No hidden scale in logical wall plane"),Wall->QueryLogicalBaseSurfaces(Surfaces,Status));Wall->SetActorScale3D(FVector::OneVector);
