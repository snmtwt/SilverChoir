body {
	width: 100%;
	height: 100%;
	margin: 0;
	font-family: Roboto;
	color: #f5f7fb;
	background-color: #11151c;
	display: flex;
	align-items: center;
	justify-content: center;
}

.shell {
	width: 620px;
	padding: 36px;
	background-color: #1b222d;
	border: 1px #354254;
	border-radius: 8px;
}

.eyebrow {
	color: #5ed1a8;
	font-size: 13px;
	letter-spacing: 1px;
	margin-bottom: 8px;
}

h1 {
	font-size: 34px;
	margin: 0 0 8px 0;
}

.summary {
	font-size: 16px;
	line-height: 1.5;
	color: #b9c3d1;
	margin: 0 0 24px 0;
}

.metrics {
	display: flex;
	gap: 12px;
	margin-bottom: 24px;
}

.metric {
	flex: 1;
	padding: 14px;
	background-color: #121820;
	border-radius: 5px;
}

.metric-label {
	display: block;
	color: #8290a3;
	font-size: 12px;
	margin-bottom: 5px;
}

label {
	font-size: 13px;
	color: #b9c3d1;
	margin-bottom: 7px;
}

input {
	width: 100%;
	height: 42px;
	padding: 0 12px;
	color: #ffffff;
	background-color: #0e131a;
	border: 1px #435269;
	border-radius: 4px;
}

input:focus {
	border-color: #5ed1a8;
}

.binding-line {
	font-size: 13px;
	color: #8290a3;
	margin: 8px 0 20px 0;
}

.binding-line span {
	color: #f5f7fb;
}

button {
	width: 100%;
	height: 44px;
	color: #07130f;
	background-color: #5ed1a8;
	border-width: 0;
	border-radius: 4px;
	font-weight: bold;
	transition: background-color 0.12s, transform 0.12s;
}

button:hover {
	background-color: #7be0bc;
	transform: translateY(-1px);
}

button:active {
	background-color: #47b990;
	transform: translateY(1px);
}
