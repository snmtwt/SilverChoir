# Generated for GridStrategyMapSystem path visualization.
# Units: centimeters. Mesh lies in XY plane, points along local +X, bottom face is Z=0.
# Matched to GSM_PathArrow_Head_70cm tail: Y=-9..9, Z=0..6.
mtllib GSM_PathArrowKit.mtl
o GSM_PathArrow_Body_Rect_Matched_100cm
usemtl PathArrow_Cyan
s off
v 0.0000 -9.0000 0.0000
v 100.0000 -9.0000 0.0000
v 100.0000 9.0000 0.0000
v 0.0000 9.0000 0.0000
v 0.0000 -9.0000 6.0000
v 100.0000 -9.0000 6.0000
v 100.0000 9.0000 6.0000
v 0.0000 9.0000 6.0000
vn 0.0000 0.0000 1.0000
vn 0.0000 0.0000 -1.0000
vn 0.0000 -1.0000 0.0000
vn 1.0000 0.0000 0.0000
vn 0.0000 1.0000 0.0000
vn -1.0000 0.0000 0.0000
f 5//1 6//1 7//1
f 5//1 7//1 8//1
f 3//2 2//2 1//2
f 4//2 3//2 1//2
f 1//3 2//3 6//3 5//3
f 2//4 3//4 7//4 6//4
f 3//5 4//5 8//5 7//5
f 4//6 1//6 5//6 8//6
